<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>RhinosCanFly</AssemblyName>
    <RootNamespace>RhinosCanFly</RootNamespace>
    <SourceStyleSeverity Condition="'$(SourceStyleSeverity)' == ''">error</SourceStyleSeverity>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Allow restore/design-time project loading on non-Windows hosts. -->
    <EnableWindowsTargeting Condition="'$(RhinosCanFlyPlatform)' == 'win'">true</EnableWindowsTargeting>
    <UseWindowsForms Condition="'$(RhinosCanFlyPlatform)' == 'win'">true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Viterkim/RhinosCanFly</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="src/Resources/RhinosCanFly.ico" LogicalName="RhinosCanFly.Resources.PluginIcon.ico" />
  </ItemGroup>
  <Target Name="CheckSourceStyle" BeforeTargets="CoreCompile">
    <Exec Command="dotnet fsi &quot;$(MSBuildProjectDirectory)/tools/check-source-style.fsx&quot; -- &quot;$(MSBuildProjectDirectory)/src&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="SourceStyleExitCode" />
    </Exec>
    <Warning Condition="'$(SourceStyleExitCode)' != '0' and '$(SourceStyleSeverity)' != 'error'" Code="RCF0001" Text="F# source style checks failed. Set SourceStyleSeverity=error to fail the build." />
    <Error Condition="'$(SourceStyleExitCode)' != '0' and '$(SourceStyleSeverity)' == 'error'" Code="RCF0001" Text="F# source style checks failed." />
  </Target>
  <Target Name="CheckPlatformBoundaries" BeforeTargets="CoreCompile">
    <Exec Command="dotnet fsi &quot;$(MSBuildProjectDirectory)/tools/check-platform-boundaries.fsx&quot; -- &quot;$(MSBuildProjectDirectory)/src&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="PlatformBoundariesExitCode" />
    </Exec>
    <Error Condition="'$(PlatformBoundariesExitCode)' != '0'" Code="RCF0002" Text="Platform implementation details must stay under src/Platform." />
  </Target>
  <ItemGroup>
    <Compile Include="src/AssemblyInfo.fs" />
    <Compile Include="src/Configuration/ConfigTypes.fs" />
    <Compile Include="src/Platform/Win/BindingTypes.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Core/CameraInputTypes.fs" />
    <Compile Include="src/Core/FlightInput.fs" />
    <Compile Include="src/Core/RhinoSettings.fs" />
    <Compile Include="src/Core/Speed.fs" />
    <Compile Include="src/Core/MouseSensitivity.fs" />
    <Compile Include="src/Core/InputAccumulator.fs" />
    <Compile Include="src/Platform/Win/PlatformTypes.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/Win32Native.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/Win32.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputNative.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/PlatformBindings.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Configuration/RuntimeConfig.fs" />
    <Compile Include="src/Platform/Win/FlightKeyboardSuppression.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Fly/FlightTypes.fs" />
    <Compile Include="src/Configuration/ConfigSchema.fs" />
    <Compile Include="src/Configuration/ConfigStorage.fs" />
    <Compile Include="src/Commands/RepeatBehavior.fs" />
    <Compile Include="src/Fly/Movement.fs" />
    <Compile Include="src/Fly/FlightSpeed.fs" />
    <Compile Include="src/Platform/Win/RawInputReceiver.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputThread.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputWake.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/ViewNavigationTypes.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/ViewNavigationState.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/ViewLatchTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RightClickTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/SideButtonTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseButtonOverrides.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/PlatformInput.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Fly/FlightRedraw.fs" />
    <Compile Include="src/Fly/ViewTarget.fs" />
    <Compile Include="src/Fly/FlightCamera.fs" />
    <Compile Include="src/Fly/FlightControls.fs" />
    <Compile Include="src/Fly/FlightState.fs" />
    <Compile Include="src/Fly/FlightLoop.fs" />
    <Compile Include="src/Fly/FlightSession.fs" />
    <Compile Include="src/Configuration/RuntimeSettings.fs" />
    <Compile Include="src/UI/SettingsUi.fs" />
    <Compile Include="src/UI/SettingsLayout.fs" />
    <Compile Include="src/UI/BindingCapture.fs" />
    <Compile Include="src/UI/SettingsFields.fs" />
    <Compile Include="src/UI/SettingsConfig.fs" />
    <Compile Include="src/UI/SettingsControl.fs" />
    <Compile Include="src/Settings/Settings.fs" />
    <Compile Include="src/UI/SettingsDialog.fs" />
    <Compile Include="src/Plugin/Plugin.fs" />
    <Compile Include="src/Commands/Commands.fs" />
    <Compile Include="src/Commands/RhinoCommands.fs" />
  </ItemGroup>
</Project>
