<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>RhinosCanFly</AssemblyName>
    <RootNamespace>RhinosCanFly</RootNamespace>
    <RunSourceChecks Condition="'$(RunSourceChecks)' == ''">true</RunSourceChecks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Allow restore/design-time project loading on non-Windows hosts. -->
    <EnableWindowsTargeting Condition="'$(RhinosCanFlyPlatform)' == 'win'">true</EnableWindowsTargeting>
    <UseWindowsForms Condition="'$(RhinosCanFlyPlatform)' == 'win'">true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Viterkim/RhinosCanFly</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="src/Resources/RhinosCanFly.ico" LogicalName="RhinosCanFly.Resources.PluginIcon.ico" />
  </ItemGroup>
  <Target Name="CheckSource" BeforeTargets="CoreCompile" Condition="'$(RunSourceChecks)' == 'true'">
    <Exec Command="dotnet fsi &quot;$(MSBuildProjectDirectory)/tools/check-all.fsx&quot; -- &quot;$(MSBuildProjectDirectory)/src&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="SourceCheckExitCode" />
    </Exec>
    <Error Condition="'$(SourceCheckExitCode)' != '0'" Code="RCF0001" Text="F# source checks failed." />
  </Target>
  <ItemGroup>
    <Compile Include="src/AssemblyInfo.fs" />
    <Compile Include="src/Configuration/ConfigTypes.fs" />
    <Compile Include="src/Configuration/ConfigSchema.fs" />
    <Compile Include="src/Core/CameraInputTypes.fs" />
    <Compile Include="src/Core/FlightInput.fs" />
    <Compile Include="src/Core/RhinoSettings.fs" />
    <Compile Include="src/Core/Speed.fs" />
    <Compile Include="src/Core/MouseSensitivity.fs" />
    <Compile Include="src/Core/ViewNavigationTypes.fs" />
    <Compile Include="src/Core/MouseActionTypes.fs" />
    <Compile Include="src/Platform/Win/BindingTypes.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Core/InputAccumulator.fs" />
    <Compile Include="src/Platform/Win/PlatformTypes.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/Win32Native.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/Win32.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/PlatformCursorClip.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputNative.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/PlatformBindings.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Configuration/RuntimeConfig.fs" />
    <Compile Include="src/Platform/Win/FlightKeyboardSuppression.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Fly/FlightTypes.fs" />
    <Compile Include="src/Configuration/ConfigCompiler.fs" />
    <Compile Include="src/Configuration/ConfigDocument.fs" />
    <Compile Include="src/Configuration/ConfigMigration.fs" />
    <Compile Include="src/Configuration/ConfigRepair.fs" />
    <Compile Include="src/Configuration/ConfigStorage.fs" />
    <Compile Include="src/Core/RepeatBehavior.fs" />
    <Compile Include="src/Fly/Movement.fs" />
    <Compile Include="src/Fly/ViewportNavigation.fs" />
    <Compile Include="src/Fly/FlightSpeed.fs" />
    <Compile Include="src/Platform/Win/RawInputSession.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputReceiver.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputThread.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawInputWake.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/RawViewNavigationSession.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/MouseOverrideTypes.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/MouseOverrideState.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/GestureNavigationTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/ViewLatchTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/RightClickTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/SideButtonTransitions.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/RawNavigationCoordinator.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/ViewportRegistry.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/MouseHook.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Platform/Win/MouseOverrides/MouseButtonOverrides.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Fly/ViewTarget.fs" />
    <Compile Include="src/Platform/Win/PlatformInput.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Fly/NavigationTarget.fs" />
    <Compile Include="src/Fly/FlightCamera.fs" />
    <Compile Include="src/Fly/FlightControls.fs" />
    <Compile Include="src/Fly/FlightState.fs" />
    <Compile Include="src/Fly/FlightLoop.fs" />
    <Compile Include="src/Fly/FlightSession.fs" />
    <Compile Include="src/Configuration/RuntimeSettings.fs" />
    <Compile Include="src/UI/SettingsUi.fs" />
    <Compile Include="src/UI/SettingsLayout.fs" />
    <Compile Include="src/UI/BindingCapture.fs" />
    <Compile Include="src/UI/SettingsFields.fs" />
    <Compile Include="src/UI/SettingsConfig.fs" />
    <Compile Include="src/UI/SettingsControl.fs" />
    <Compile Include="src/Settings/Settings.fs" />
    <Compile Include="src/UI/SettingsDialog.fs" />
    <Compile Include="src/Core/CurrentConfig.fs" />
    <Compile Include="src/Fly/FlightStart.fs" />
    <Compile Include="src/Fly/SpeedSelection.fs" />
    <Compile Include="src/Fly/StandaloneNavigation.fs" />
    <Compile Include="src/Settings/Options.fs" />
    <Compile Include="src/Platform/Win/InputRecovery.fs" Condition="'$(RhinosCanFlyPlatform)' == 'win'" />
    <Compile Include="src/Plugin/Plugin.fs" />
    <Compile Include="src/Commands/RhinosCanFly.fs" />
    <Compile Include="src/Commands/RhinosCanFlyTempFly.fs" />
    <Compile Include="src/Commands/RhinosCanWalk.fs" />
    <Compile Include="src/Commands/RhinosCanFlyHeld.fs" />
    <Compile Include="src/Commands/RhinosCanFlyTempFlyHeld.fs" />
    <Compile Include="src/Commands/RhinosCanFlyOptions.fs" />
    <Compile Include="src/Commands/RhinosCanFlySetSpeed.fs" />
    <Compile Include="src/Commands/RhinosCanFlyPivot.fs" />
    <Compile Include="src/Commands/RhinosCanFlyPan.fs" />
    <Compile Include="src/Commands/RhinosCanFlyInputRecover.fs" />
    <Compile Include="src/Commands/RhinosCanFlyToggleEnable.fs" />
    <Compile Include="src/Commands/Commands.fs" />
  </ItemGroup>
</Project>
